  "prime_stream_max_new_tokens": 48,
  
  "stream_chunk_size": 8,
  "inference_logging": {
    "console": true,
    "file": "../faster-qwen3-tts-assets/logs/inference_v5.log",
    "add_timestamp": true,
    "level": "INFO"
  }
}
